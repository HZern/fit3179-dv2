{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map of STEM higher education enrolments in each Australian state and territory, 2024.",
  "width": "container",
  "height": 360,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ],
    "center": [
      0,
      -27.5
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/au_states.topo.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e7e3da",
        "stroke": "#fff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/state_stem_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Natural & physical sciences": "number",
            "Information technology": "number",
            "Engineering": "number",
            "Agriculture & environment": "number",
            "stem": "number",
            "total": "number",
            "stem_share": "number",
            "unis": "number",
            "top_uni_stem": "number",
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "stroke": "#fff",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "stem",
          "type": "quantitative",
          "title": "STEM enrolments",
          "scale": {
            "domain": [
              0,
              150000
            ],
            "range": [
              0,
              1400.0
            ],
            "zero": true
          },
          "legend": {
            "orient": "top",
            "values": [
              10000,
              50000,
              150000
            ],
            "labelExpr": "format(datum.value, ',')",
            "symbolFillColor": "#2a9d8f",
            "symbolOpacity": 0.75,
            "symbolStrokeColor": "#fff"
          }
        },
        "color": {
          "value": "#2a9d8f"
        },
        "opacity": {
          "condition": {
            "param": "hov",
            "empty": false,
            "value": 1
          },
          "value": 0.8
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "stem",
            "format": ",",
            "title": "STEM enrolments"
          },
          {
            "field": "stem_share",
            "title": "% of all enrolments in STEM"
          },
          {
            "field": "unis",
            "title": "Universities teaching STEM"
          },
          {
            "field": "top_uni",
            "title": "Largest STEM university"
          },
          {
            "field": "top_uni_stem",
            "format": ",",
            "title": " - its STEM enrolments"
          }
        ]
      },
      "params": [
        {
          "name": "hov",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout",
            "fields": [
              "state"
            ]
          }
        }
      ]
    },
