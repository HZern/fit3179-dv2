{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart of girls' share of Year 12 enrolments in STEM subjects, 2013 vs 2024.",
  "data": {
    "url": "data/y12_girls_share.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "girls_pct": "number"
      }
    }
  },
  "width": "container",
  "height": 300,
  "layer": [
    {
      "data": {
        "values": [
          {
            "x": 50
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#5f6b7a",
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 50,
            "t": "Equal share (50%)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "dy": -6,
        "color": "#5f6b7a",
        "fontSize": 10.5,
        "baseline": "bottom"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#c9c4b8",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "girls_pct",
          "type": "quantitative"
        },
        "y": {
          "field": "subject",
          "type": "nominal",
          "title": null,
          "sort": [
            "Biological sciences",
            "Other natural & physical sciences",
            "Earth sciences",
            "Agriculture & environment",
            "Chemical sciences",
            "Mathematical sciences",
            "Engineering",
            "Information technology",
            "Physics & astronomy"
          ],
          "axis": {
            "domain": false,
            "ticks": false,
            "grid": true,
            "gridDash": [
              2,
              3
            ],
            "labelFontSize": 11.5
          }
        },
        "detail": {
          "field": "subject"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 120,
        "opacity": 1,
        "stroke": "#fff",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "subject",
          "type": "nominal",
          "title": null,
          "sort": [
            "Biological sciences",
            "Other natural & physical sciences",
            "Earth sciences",
            "Agriculture & environment",
            "Chemical sciences",
            "Mathematical sciences",
            "Engineering",
            "Information technology",
            "Physics & astronomy"
          ],
          "axis": {
            "domain": false,
            "ticks": false,
            "grid": true,
            "gridDash": [
              2,
              3
            ],
            "labelFontSize": 11.5
          }
        },
        "x": {
          "field": "girls_pct",
          "type": "quantitative",
          "title": "Girls' share of Year 12 enrolments (%)",
          "scale": {
            "domain": [
              0,
              80
            ]
          },
          "axis": {
            "tickCount": 8
          }
        },
        "color": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "scale": {
            "domain": [
              2013,
              2024
            ],
            "range": [
              "#b9c0c9",
              "#c8553d"
            ]
          }
        },
        "tooltip": [
          {
            "field": "subject",
            "title": "Subject"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "girls_pct",
            "title": "Girls' share (%)"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "IBM Plex Sans",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5f6b7a",
      "titleColor": "#5f6b7a",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "gridColor": "#e6e3dc",
      "domainColor": "#c9c4b8",
      "tickColor": "#c9c4b8"
    },
    "legend": {
      "labelColor": "#1d2433",
      "titleColor": "#5f6b7a",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "orient": "top",
      "symbolStrokeWidth": 0
    },
    "header": {
      "labelColor": "#1d2433",
      "labelFontSize": 12,
      "labelFontWeight": 600,
      "titleColor": "#5f6b7a"
    },
    "title": {
      "color": "#1d2433",
      "font": "Space Grotesk",
      "fontSize": 15,
      "fontWeight": 600,
      "anchor": "start",
      "subtitleColor": "#5f6b7a",
      "subtitleFont": "IBM Plex Sans",
      "subtitleFontSize": 12,
      "offset": 10
    },
    "text": {
      "font": "IBM Plex Sans",
      "color": "#1d2433"
    }
  }
}