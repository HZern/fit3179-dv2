{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth of the share of university enrolments in STEM fields by state/territory of the institution, 2024.",
  "width": "container",
  "height": 330,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ],
    "center": [
      0,
      -27.5
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/au_states.topo.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "data/state_stem_2024.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "Natural & physical sciences": "number",
                  "Information technology": "number",
                  "Engineering": "number",
                  "Agriculture & environment": "number",
                  "stem": "number",
                  "total": "number",
                  "stem_share": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "stem_share",
              "stem",
              "total"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fff",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "stem_share",
          "type": "quantitative",
          "title": "% of uni enrolments in STEM",
          "scale": {
            "type": "threshold",
            "domain": [
              22,
              25,
              27,
              29
            ],
            "range": [
              "#d7ebe8",
              "#a6d2cb",
              "#6fb3aa",
              "#36897f",
              "#0f5e57"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "titleLimit": 400
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "State / territory"
          },
          {
            "field": "stem_share",
            "title": "% in STEM"
          },
          {
            "field": "stem",
            "format": ",",
            "title": "STEM enrolments"
          },
          {
            "field": "total",
            "format": ",",
            "title": "All enrolments"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "dx": 0,
        "dy": 0,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#fff",
        "text": "WA 27%"
      },
      "encoding": {
        "longitude": {
          "datum": 121.5
        },
        "latitude": {
          "datum": -26
        }
      }
    },
    {
      "data": {
