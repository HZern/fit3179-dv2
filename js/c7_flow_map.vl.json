{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Flow map of international higher education students in Australia from the 15 largest source countries, 2024.",
  "width": "container",
  "height": 500,
  "projection": {
    "type": "mercator",
    "center": [
      104,
      -2
    ],
    "scale": 330
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2.0.2/countries-50m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e7e3da",
        "stroke": "#fff",
        "strokeWidth": 0.5,
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2.0.2/countries-50m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name == 'Australia' || datum.properties.name == 'Malaysia'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fff",
        "strokeWidth": 0.5,
        "clip": true
      },
      "encoding": {
        "fill": {
          "condition": {
            "test": "datum.properties.name == 'Malaysia'",
            "value": "#f0cfc4"
          },
          "value": "#cfe5e1"
        }
      }
    },
    {
      "data": {
        "url": "data/intl_students_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "students": "number",
            "lon": "number",
            "lat": "number",
            "dest_lon": "number",
            "dest_lat": "number"
          }
        }
      },
      "layer": [
        {
          "params": [
            {
              "name": "hl",
              "select": {
                "type": "point",
                "on": "pointerover",
                "clear": "pointerout",
                "fields": [
                  "country"
                ]
              }
            }
          ],
          "mark": {
            "type": "rule",
            "strokeCap": "round"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "dest_lon"
            },
            "latitude2": {
              "field": "dest_lat"
            },
            "strokeWidth": {
              "field": "students",
              "type": "quantitative",
              "scale": {
                "range": [
                  1,
                  16
                ],
                "zero": true
              },
              "title": "International uni students, 2024",
              "legend": {
                "orient": "top",
                "values": [
                  10000,
                  50000,
                  150000
                ],
                "labelExpr": "format(datum.value, ',')",
                "titleLimit": 400
              }
            },
            "color": {
              "field": "highlight",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Malaysia",
                  "Other"
                ],
                "range": [
                  "#c8553d",
                  "#2a8c83"
                ]
              },
              "legend": null
            },
            "opacity": {
              "condition": {
                "param": "hl",
                "empty": false,
                "value": 0.95
              },
              "value": 0.45
            },
            "tooltip": [
              {
                "field": "country",
                "title": "Home country"
              },
              {
                "field": "students",
                "format": ",",
                "title": "Students enrolled with Australian unis"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "circle",
            "size": 50,
            "stroke": "#fff",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "color": {
              "field": "highlight",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Malaysia",
                  "Other"
                ],
                "range": [
                  "#c8553d",
                  "#2a8c83"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "country",
                "title": "Home country"
              },
              {
                "field": "students",
                "format": ",",
                "title": "Students"
              }
            ]
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {}
