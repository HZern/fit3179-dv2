      "fontSize": 15,
      "fontWeight": 600,
      "anchor": "start",
      "subtitleColor": "#5f6b7a",
      "subtitleFont": "IBM Plex Sans",
      "subtitleFontSize": 12,
      "offset": 10
    },
    "text": {
