{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map of PISA 2022 mean mathematics scores by country (OECD).",
  "width": "container",
  "height": 380,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2.0.2/countries-50m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name != 'Antarctica'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e4e0d8",
        "stroke": "#fff",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2.0.2/countries-50m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "data/pisa2022_maths.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "maths": "number",
                  "rank": "number"
                }
              }
            },
            "key": "name",
            "fields": [
              "maths",
              "rank",
              "pisa_name"
            ]
          }
        },
        {
          "filter": "isValid(datum.maths)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fff",
        "strokeWidth": 0.4
      },
      "encoding": {
        "color": {
          "field": "maths",
          "type": "quantitative",
          "title": "Mean maths score (OECD average = 472)",
          "scale": {
            "type": "threshold",
            "domain": [
              400,
              440,
              472,
              500,
              540
            ],
            "range": [
              "#f3e3d3",
              "#e4c3a4",
              "#c8d9d6",
              "#7fb8b1",
              "#2a8c83",
              "#105e5a"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "titleLimit": 400
          }
        },
        "strokeWidth": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1.8
          },
          "value": 0.4
        },
        "stroke": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": "#1d2433"
          },
          "value": "#fff"
        },
        "tooltip": [
          {
            "field": "pisa_name",
            "title": "Country / economy"
          },
          {
            "field": "maths",
            "title": "PISA 2022 maths score"
          },
          {
            "field": "rank",
            "title": "Rank (of 81)"
          }
        ]
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout",
            "fields": [
              "properties.name"
            ]
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "lon": 134,
            "lat": -25
          },
          {
            "lon": 101.7,
            "lat": 3.6
          },
          {
            "lon": 103.8,
            "lat": 1.35
          }
        ]
      },
      "mark": {
        "type": "circle",
        "size": 26,
        "color": "#1d2433",
        "stroke": "#fff",
        "strokeWidth": 1,
        "opacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": 0,
        "fontSize": 11.5,
        "fontWeight": 600,
        "color": "#1d2433",
        "text": "Australia 487 (above OECD avg)",
        "stroke": "#fbfaf7",
        "strokeWidth": 3,
        "strokeJoin": "round"
      },
      "encoding": {
        "longitude": {
          "datum": 134
        },
        "latitude": {
          "datum": -25
        }
      }
    },
