    "axis": {
      "labelColor": "#5f6b7a",
      "titleColor": "#5f6b7a",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "gridColor": "#e6e3dc",
      "domainColor": "#c9c4b8",
      "tickColor": "#c9c4b8"
    },
    "legend": {
